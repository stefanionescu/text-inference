# Deny everything by default.
**

# Allow only files required by the vLLM Dockerfile.
!.dockerignore
!Dockerfile
!pyproject.toml
!uv.lock
!docker/
!docker/__init__.py
!docker/base/
!docker/base/__init__.py
!docker/base/download/
!docker/base/download/**
!docker/vllm/
!docker/vllm/__init__.py
!docker/vllm/download/
!docker/vllm/download/**
!base/scripts/
!base/scripts/**
!scripts/
!scripts/**
!src/
!src/**
!config/
!config/**

# Keep local tool output and environment files out of the allowed folders.
**/.git/**
**/.venv/**
**/venv/**
**/__pycache__/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.mypy_cache/**
**/coverage/**
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*

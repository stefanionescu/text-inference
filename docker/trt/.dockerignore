# Deny everything by default.
**

# Allow only files required by the TRT Dockerfile.
!.dockerignore
!Dockerfile
!pyproject.toml
!uv.lock
!docker/
!docker/__init__.py
!docker/shared/
!docker/shared/__init__.py
!docker/shared/download/
!docker/shared/download/**
!docker/trt/
!docker/trt/__init__.py
!docker/trt/download/
!docker/trt/download/**
!shared/scripts/
!shared/scripts/**
!scripts/
!scripts/**
!src/
!src/**
!config/
!config/**

# Keep local tool output and environment files out of the allowed folders.
**/.git/**
**/.venv/**
**/venv/**
**/__pycache__/**
**/.pytest_cache/**
**/.ruff_cache/**
**/.mypy_cache/**
**/coverage/**
**/.env
**/.env.*
**/.dev.vars
**/.dev.vars.*

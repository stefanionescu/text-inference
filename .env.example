# Text Inference Environment
#
# Host deployment selects the model and engine through scripts/main.sh flags.
# It detects the runtime checkpoint format. Use --quantization only to request
# a local export.

# Required deployment values
API_KEY=
HF_TOKEN=
MAX_CONCURRENT_CONNECTIONS=

# Source and export behavior
# MODEL_REVISION=main
# QUANT_FORCE_REBUILD=0

# GPU and cache policy
# GPU_MEMORY_FRACTION=0.90
# GPU_SM_ARCH=
# KV_DTYPE=auto

# TensorRT-LLM public PyTorch backend
# TRT_DTYPE=auto
# TRT_MAX_BATCH_SIZE=64

# Model Optimizer 0.45 calibration
# TRT_AWQ_BLOCK_SIZE=128
# TRT_CALIBRATION_DATASET=cnn_dailymail
# TRT_CALIBRATION_SAMPLES=64
# TRT_CALIBRATION_SEQUENCE_LENGTH=512
# TRT_CALIBRATION_MEMORY_FRACTION=0.8
# TRT_SEQUENTIAL_DEVICE_MAP=0

# vLLM 0.25.1
# ENFORCE_EAGER=0
# VLLM_CALIBRATION_DATASET=open_platypus
# VLLM_CALIBRATION_SAMPLES=256
# VLLM_CALIBRATION_SEQUENCE_LENGTH=512
# VLLM_CALIBRATION_BATCH_SIZE=1
# VLLM_CALIBRATION_PIPELINE=independent

# Fresh quantized-checkpoint uploads
# HF_PUSH_REPO_ID=
# HF_PUSH_PRIVATE=1

# Prompt and context limits
# PROMPT_MAX_TOKENS=1500
# HISTORY_MAX_TOKENS=3000
# USER_UTTERANCE_MAX_TOKENS=500
# HISTORY_RETENTION_PERCENTAGE=66
# CONTEXT_BUFFER=25
# MAXIMUM_OUTPUT_TOKENS=150
# TEMPLATE_ENABLE_THINKING=0

# Sampling
# TEMPERATURE=0.8
# TOP_P=0.95
# TOP_K=30
# MIN_P=0.0
# REPETITION_PENALTY=1.0
# PRESENCE_PENALTY=0.0
# FREQUENCY_PENALTY=0.0

# Session and streaming
# CACHE_RESET_INTERVAL_SECONDS=600
# STREAM_FLUSH_MILLISECONDS=0
# GENERATION_TIMEOUT_SECONDS=60

# WebSocket protocol and admission
# WEBSOCKET_IDLE_TIMEOUT_SECONDS=150
# WEBSOCKET_WATCHDOG_TICK_SECONDS=10
# WEBSOCKET_HANDSHAKE_ACQUIRE_TIMEOUT_SECONDS=0.5
# WEBSOCKET_PROTOCOL_VERSION=1
# WEBSOCKET_MAX_MESSAGE_BYTES=65536
# WEBSOCKET_RATE_LIMIT_WINDOW_SECONDS=60
# WEBSOCKET_MESSAGES_PER_WINDOW=20
# WEBSOCKET_CANCELS_PER_WINDOW=20
# AUTHENTICATION_FAILURE_LIMIT=10

# Logging
# APPLICATION_LOG_LEVEL=INFO

# Sentry
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_SAMPLE_RATE=1.0

# Axiom and OpenTelemetry
# AXIOM_API_TOKEN=
# AXIOM_DATASET=text-inference-api
# AXIOM_ENVIRONMENT=production
# AXIOM_TRACES_ENDPOINT=https://api.axiom.co/v1/traces
# AXIOM_METRICS_ENDPOINT=https://api.axiom.co/v1/metrics
# OTEL_RESOURCE_NAME=text-inference-api
# OTEL_TRACES_EXPORT_INTERVAL_MILLISECONDS=5000
# OTEL_METRICS_EXPORT_INTERVAL_MILLISECONDS=15000
# OTEL_TRACES_BATCH_SIZE=512
# CLOUD_PLATFORM=

# Set by the deployment scripts and container images
# MODEL=
# MODEL_PATH=
# INFERENCE_ENGINE=trt
# RUNTIME_QUANTIZATION=

# Hugging Face cache and third-party output capture
# HUGGINGFACE_HUB_CACHE=
# DEPENDENCY_LOG_FILE=

# Test clients
# SERVER_URL=ws://127.0.0.1:8000/ws
# GENDER=female
# PERSONALITY=flirty

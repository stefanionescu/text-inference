{
    "version": 1,
    "global_policy": {
        "are_digits_banned": true,
        "banned_term_exemptions": [
            "HF_TOKEN",
            "HUGGINGFACE_TOKEN",
            "ID2LABEL",
            "LABEL2ID",
            "__all__",
            "__init__",
            "__main__"
        ],
        "banned_terms": [
            "fixture",
            "fixtures",
            "shim",
            "shims",
            "if_needed",
            "ifneeded",
            "if_changed",
            "ifchanged",
            "if_possible",
            "ifpossible",
            "if_available",
            "ifavailable",
            "maybe",
            "render",
            "resolve",
            "resolving",
            "resolution",
            "synchronize",
            "synchronise",
            "sync_",
            "sync-",
            "-sync",
            "_sync",
            "once",
            "corpus",
            "catalog",
            "catalogue",
            "transient",
            "load",
            "loaded",
            "loader",
            "loaders",
            "loading",
            "fetch",
            "should",
            "materialize",
            "materialise",
            "ensure",
            "likely",
            "belt and suspenders",
            "undertest",
            "under_test",
            "under-test",
            "coerce",
            "taxonomy",
            "orthrow",
            "or_throw",
            "testcase",
            "test_case",
            "test case",
            "edge case",
            "edge-case",
            "edge_cases",
            "runpsql",
            "prelock",
            "postlock",
            "with retries",
            "with_retries",
            "enhanced",
            "advanced",
            "improved",
            "optimized",
            "robust",
            "seamless",
            "modern",
            "smart",
            "intelligent",
            "comprehensive",
            "ultimate",
            "generic",
            "reusable",
            "custom",
            "final",
            "old",
            "latest",
            "manager",
            "handler",
            "helper",
            "util",
            "utils",
            "processor",
            "service",
            "info",
            "details",
            "object",
            "thing",
            "stuff",
            "common",
            "core",
            "and",
            "or",
            "with",
            "plus",
            "combined",
            "waitfor",
            "scoped",
            "data"
        ]
    },
    "languages": {
        "python": {
            "max_characters": 35,
            "max_words": 4,
            "files": ["snake"],
            "directories": ["snake"],
            "modules": ["snake"],
            "packages": ["snake"],
            "classes": ["pascal"],
            "exceptions": ["pascal"],
            "functions": ["snake"],
            "methods": ["snake"],
            "parameters": ["snake"],
            "variables": ["snake", "upper-snake"],
            "constants": ["upper-snake"],
            "attributes": ["snake", "upper-snake"],
            "type_aliases": ["pascal"]
        },
        "shell": {
            "max_characters": 35,
            "max_words": 4,
            "files": ["kebab", "snake"],
            "directories": ["kebab", "snake"],
            "functions": ["snake"],
            "variables": ["snake", "upper-snake"]
        }
    },
    "name_rules": [
        {
            "path_regexes": ["^(\\.githooks/|\\.mise/tasks/).*"],
            "languages": ["shell"],
            "categories": ["directories"],
            "names": [".githooks", ".mise"],
            "is_excluded": true
        },
        {
            "path_regexes": ["^(tests/suites/e2e/|\\.mise/tasks/test/e2e/).*"],
            "categories": ["directories"],
            "names": ["e2e"],
            "are_digits_allowed": true,
            "are_duplicate_words_allowed": true
        },
        {
            "path_regexes": [".*"],
            "languages": ["python"],
            "categories": ["methods"],
            "names": [
                "visit_ClassDef",
                "visit_FunctionDef",
                "visit_AsyncFunctionDef",
                "visit_Import",
                "visit_ImportFrom",
                "visit_Assign",
                "visit_AnnAssign",
                "visit_If",
                "visit_Name",
                "visit_Attribute"
            ],
            "is_excluded": true
        },
        {
            "path_regexes": ["^quality/security/codeql/scan\\.sh$"],
            "languages": ["shell"],
            "categories": ["variables"],
            "names": [
                "CODEQL_EXTRACTOR_PYTHON_ANALYSIS_VERSION",
                "CODEQL_EXTRACTOR_PYTHON_OPTION_PYTHON_EXECUTABLE_NAME"
            ],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "languages": ["shell"],
            "categories": ["variables"],
            "names": ["CUDA_MODULE_LOADING", "HF_HUB_DISABLE_PROGRESS_BARS", "HF_HUB_ENABLE_HF_TRANSFER"],
            "is_excluded": true
        },
        {
            "path_regexes": ["^(scripts/steps/[0-9]{2}_.*\\.sh|\\.mise/tasks/.+)$"],
            "languages": ["shell"],
            "categories": ["files"],
            "structural_prefix_regexes": ["^\\d{2}_"]
        },
        {
            "path_regexes": [".*"],
            "categories": [
                "variables",
                "constants",
                "classes",
                "exceptions",
                "type_aliases",
                "attributes",
                "parameters"
            ],
            "names": ["_"],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "categories": [
                "variables",
                "constants",
                "classes",
                "exceptions",
                "type_aliases",
                "attributes",
                "parameters"
            ],
            "structural_prefix_regexes": ["^_+"]
        },
        {
            "path_regexes": ["^scripts/config/.*\\.sh$"],
            "languages": ["shell"],
            "categories": ["variables"],
            "structural_prefix_regexes": [
                "^CFG_",
                "^(?:DEFAULTS|MAIN|RESTART|STOP|PATTERN|MODEL|QUANT|RUNTIME|TRT|PIP|MPI|HF)_",
                "^(?:MSG|ERR|MODE|TOKEN|KIND|DEFAULT|BUILD|ENGINE|SERVER|WARMUP|HEALTH|HUB|PREBUFFER)_",
                "^HEALTH_"
            ]
        },
        {
            "path_regexes": ["^config/.*\\.py$"],
            "languages": ["python"],
            "categories": ["constants"],
            "structural_prefix_regexes": [
                "^(?:BATCH_SCALE|MAX_NUM_SEQS|MEMORY_OPT|TRT|CACHE|OTEL_METRICS|OTEL|METRIC|HUGGING_FACE_LICENSE|HF|WEBSOCKET_HANDSHAKE|WEBSOCKET_RATE_LIMIT|WEBSOCKET_PING|WS|MIN_P|CANCEL_RECEIVE|CANCEL_DRAIN|CANCEL_POST|IDLE_NORMAL)_"
            ]
        },
        {
            "path_regexes": ["^tests/harness/environment/settings\\.py$"],
            "languages": ["python"],
            "categories": ["constants"],
            "structural_prefix_regexes": ["^DEFAULT_WEBSOCKET_PING_"]
        },
        {
            "path_regexes": ["^src/logging/dedupe\\.py$"],
            "languages": ["python"],
            "categories": ["functions"],
            "names": ["info_unique"],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "names": ["i", "j", "k", "x", "y"],
            "is_excluded": true
        },
        {
            "path_regexes": [".*"],
            "languages": ["python"],
            "categories": ["files"],
            "names": ["__init__", "__main__"],
            "is_excluded": true
        }
    ],
    "excluded_paths": [
        "/.artifacts/",
        "/.git/",
        "/.cache/",
        "/.pytest_cache/",
        "/.ruff_cache/",
        "/.venv/",
        "/.venv-quant/",
        "/__pycache__/",
        "/build/",
        "/dist/",
        "/node_modules/"
    ],
    "excluded_basenames": ["uv.lock", "bun.lock", "package-lock.json", "pnpm-lock.yaml", "yarn.lock"]
}

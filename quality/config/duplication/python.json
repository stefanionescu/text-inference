{
    "threshold": 4,
    "reporters": ["console"],
    "format": ["python"],
    "ignore": [
        "**/.artifacts/**",
        "**/.venv/**",
        "**/.venv-quant/**",
        "**/__pycache__/**",
        "**/test/results/**",
        "**/tests/results/**"
    ],
    "path": ["../../../src/", "../../../tests/", "../../../docker/", "../../"],
    "minLines": 8,
    "minTokens": 40,
    "mode": "strict",
    "output": ".artifacts/cpd/python"
}

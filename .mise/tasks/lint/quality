#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
cd "${REPO_ROOT}"

bunx markdownlint-cli2
bunx prettier . --check
typos .
uv run python -m quality.repository.dependencies
uv run validate-pyproject pyproject.toml
uv run pyproject-fmt --check pyproject.toml
bunx jscpd --config quality/config/duplication/python.json
bunx jscpd --config quality/config/duplication/bash.json

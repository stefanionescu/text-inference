        "../../../../**/.pytest_cache/**",
        "../../../../**/.ruff_cache/**",
        "../../../../**/.mypy_cache/**",
        "../../../../**/coverage/**",
        "../../../../venv/**",
        "../../../../**/cache/**",
        "../../../../**/.cache/**",
        "../../../../**/htmlcov/**",
        "../../../../**/node_modules/**",
        "../../../../**/reports/**",
        "../../../../tests/results/**",
        "../../../../**/.idea/**",
        "../../../../**/.claude/**",
        "../../../../**/.vscode/**",
        "../../../../**/.cursor/**",
        "../../../../src/engines/trt/factory.py",
        "../../../../src/engines/vllm/factory.py",
        "../../../../src/quantization/vllm/quantize.py",
        "../../../../src/scripts/guard.py",

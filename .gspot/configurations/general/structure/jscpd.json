{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;",
        "(?:^|\\n)[\\t ]*(?:from[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*[\\w.]+[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*)?import[\\t ]+(?:\\\\\\r?\\n[\\t ]*)*(?:\\([^;)]*\\)|(?:\\\\\\r?\\n|[^;\\r\\n])*)"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/build/**",
        ".gspot/**",
        ".gspot-copies/**",
        "**/gspot.baseline.json",
        ".editorconfig",
        ".markdownlint.jsonc",
        ".prettierignore",
        "prettier.config.mjs",
        "pyrightconfig.json",
        "ruff.toml",
        "**/.venv/**",
        "**/venv/**",
        "**/__pycache__/**",
        "**/.pytest_cache/**",
        "**/.ruff_cache/**",
        "**/.mypy_cache/**",
        "**/coverage/**",
        "**/.env",
        "**/.env.*",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/uv.lock",
        "venv/**",
        "**/.artifacts",
        "**/cache/**",
        "**/*.py[cod]",
        "**/*$py.class",
        "**/*.so",
        "**/.Python",
        "**/.venv",
        "**/.venv-quant",
        "**/.nox",
        "**/.cache/**",
        "**/.pytest_cache",
        "**/.coverage",
        "**/coverage.xml",
        "**/htmlcov/**",
        "**/.ruff_cache",
        "**/.mypi_cache",
        "**/.mypy_cache",
        "**/node_modules/**",
        "**/pytest.xml",
        "**/reports/**",
        "**/*.log",
        "**/*.zip",
        "tests/results/**",
        "**/.DS_Store",
        "**/.DS_Store?",
        "**/.idea/**",
        "**/.claude/**",
        "**/.vscode/**",
        "**/*.swp",
        "**/*.swo",
        "**/.cursor/**",
        "tool/models",
        "**/.venv_tool"
    ]
}

{
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 80,
    "singleQuote": false,
    "trailingComma": "all",
    "semi": true,
    "bracketSpacing": true,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "overrides": [
        {
            "files": [
                "*.md",
                "*.mdx"
            ],
            "options": {
                "embeddedLanguageFormatting": "off"
            }
        },
        {
            "files": [
                "**/*.py"
            ],
            "excludeFiles": [],
            "options": {
                "tabWidth": 4,
                "printWidth": 120
            }
        }
    ]
}

#!/bin/sh
command -v node >/dev/null 2>&1 || { printf 'node is not on the PATH that this Git client gives hooks (%s). Start the client from a terminal, or add node'"'"'s folder to its PATH.
' "$PATH" >&2; exit 2; }
test -f node_modules/@gspothq/cli/package.json || { printf '%s\n' 'gspot is not installed in this worktree. Run bun install, then gspot install.' >&2; exit 2; }
PATH="$PWD/node_modules/.bin:$PATH" exec gspot check --hook pre-push -- "$@"
